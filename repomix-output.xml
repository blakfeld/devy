            "redis-7.2.4": {"pname": "redis", "version": "7.2.4"},
            "git-2.44.0": {"pname": "git", "version": "2.44.0"},
        });
        assert_eq!(env_find_pkg(&json, "redis"), Some("7.2.4".into()));
        assert_eq!(env_find_pkg(&json, "curl"), None);
    }
