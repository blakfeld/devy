    #[test]
    fn silent_exit_displays_code() {
        assert_eq!(format!("{}", SilentExit(1)), "exit code 1");
        assert_eq!(format!("{}", SilentExit(42)), "exit code 42");
    }

    #[test]
    fn silent_exit_code_zero_displays() {
        assert_eq!(format!("{}", SilentExit(0)), "exit code 0");
    }
}
